<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="broadband.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:broadband.Helper"
    xmlns:local="clr-namespace:broadband.Language"
    Title="WelcomePage"
    BackgroundColor="{StaticResource Primary}">
    <ScrollView>
        <StackLayout VerticalOptions="Center">

            <StackLayout Spacing="8" VerticalOptions="CenterAndExpand">
                <StackLayout Margin="0,25" Spacing="0">
                    <Label
                        FontAttributes="Bold"
                        FontFamily="MainFont"
                        FontSize="100"
                        HorizontalOptions="CenterAndExpand"
                        Text="Bb"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />

                    <Label
                        FontAttributes="Bold"
                        FontFamily="MainFont"
                        FontSize="22"
                        HorizontalOptions="CenterAndExpand"
                        Text="Broadband Internet"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />
                </StackLayout>

                <Label
                    FontAttributes="Bold"
                    FontFamily="MainFont"
                    FontSize="26"
                    HorizontalOptions="CenterAndExpand"
                    Text="{helpers:Translate welcome}"
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" />
                <Label
                    FontFamily="MainFont"
                    FontSize="14"
                    HorizontalOptions="CenterAndExpand"
                    Text="{helpers:Translate welcomeText}"
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" />

                <Frame
                    Margin="20,35,20,10"
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderColor="White"
                    HasShadow="False"
                    HorizontalOptions="FillAndExpand">
                    <Label
                        Margin="15"
                        FontAttributes="Bold"
                        FontFamily="MainFont"
                        FontSize="16"
                        HorizontalOptions="CenterAndExpand"
                        Text="{helpers:Translate newConnection}"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />
                </Frame>

                <Frame
                    Margin="20,10,20,0"
                    Padding="0"
                    BackgroundColor="White"
                    BorderColor="White"
                    HasShadow="False"
                    HorizontalOptions="FillAndExpand">
                    <Label
                        Margin="15"
                        FontAttributes="Bold"
                        FontFamily="MainFont"
                        FontSize="16"
                        HorizontalOptions="CenterAndExpand"
                        Text="{helpers:Translate login}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="CenterAndExpand" />
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="LoginTapped" />
                    </Frame.GestureRecognizers>
                </Frame>
            </StackLayout>


            <StackLayout
                Margin="0,42"
                HorizontalOptions="CenterAndExpand"
                Orientation="Horizontal"
                Spacing="0"
                VerticalOptions="EndAndExpand">
                <Label
                    Margin="15"
                    FontFamily="MainFont"
                    FontSize="12"
                    HorizontalOptions="CenterAndExpand"
                    Text="{helpers:Translate language}"
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" />

                <Frame
                    Padding="0"
                    BackgroundColor="{StaticResource PrimaryDark}"
                    BorderColor="Transparent"
                    CornerRadius="25"
                    HasShadow="False"
                    HeightRequest="44"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand">
                    <Label
                        x:Name="DefaultLanguage"
                        Margin="32,5"
                        FontAttributes="Bold"
                        FontFamily="MainFont"
                        FontSize="12"
                        HorizontalOptions="CenterAndExpand"
                        Text="English"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="LanguageTapped" />
                    </Frame.GestureRecognizers>
                </Frame>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>